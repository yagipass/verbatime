<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.yagipass</groupId>
    <artifactId>verbatime</artifactId>
    <version>0.8.1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>verbatime-agent</artifactId>
  <packaging>jar</packaging>

  <name>verbatime-agent</name>
  <description>Java agent that records a call tree per root-method execution</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <errorprone.flags>-XepOpt:NullAway:KnownInitializers=java.lang.classfile.ClassFileTransform.atStart</errorprone.flags>
    <skipTests>false</skipTests>

    <java.bin>${java.home}/bin/java</java.bin>
    <fixtures8.classes>${project.build.directory}/fixtures8-classes</fixtures8.classes>
    <agent.jar>${project.build.directory}/verbatime-agent.jar</agent.jar>
    <e2e.include>include=io.github.yagipass.verbatime.fixtures</e2e.include>
    <e2e.gate.jar>${project.build.directory}/test-tmp/dir with space/gate-main.jar</e2e.gate.jar>
    <test.classpath>${project.build.testOutputDirectory}${path.separator}${project.build.outputDirectory}${path.separator}${io.github.yagipass:verbatime-format:jar}</test.classpath>
    <corpus.dir>${project.build.directory}/corpus</corpus.dir>
    <corpus.full.dir>${project.build.directory}/corpus-full</corpus.full.dir>
    <corpus.dirs>${corpus.dir}</corpus.dirs>
    <corpus.fixtures.classes>${project.build.directory}/corpus-fixtures-classes</corpus.fixtures.classes>
    <corpus.threads></corpus.threads>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.yagipass</groupId>
      <artifactId>verbatime-format</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.google.errorprone</groupId>
      <artifactId>error_prone_annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>format-jar-property</id>
            <?m2e ignore?>
            <phase>initialize</phase>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
          <execution>
            <id>corpus-jars</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <skip>${skipTests}</skip>
              <outputDirectory>${corpus.dir}</outputDirectory>
              <artifactItems>
                <artifactItem><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId><version>2.26.1</version></artifactItem>
                <artifactItem><groupId>org.jboss.marshalling</groupId><artifactId>jboss-marshalling</artifactId><version>2.3.0</version></artifactItem>
                <artifactItem><groupId>org.jboss.marshalling</groupId><artifactId>jboss-marshalling-river</artifactId><version>2.3.0</version></artifactItem>

                <artifactItem><groupId>junit</groupId><artifactId>junit</artifactId><version>3.8.1</version></artifactItem>
                <artifactItem><groupId>ant</groupId><artifactId>ant</artifactId><version>1.6.5</version></artifactItem>
                <artifactItem><groupId>commons-collections</groupId><artifactId>commons-collections</artifactId><version>3.2.2</version></artifactItem>
                <artifactItem><groupId>commons-lang</groupId><artifactId>commons-lang</artifactId><version>2.6</version></artifactItem>
                <artifactItem><groupId>log4j</groupId><artifactId>log4j</artifactId><version>1.2.17</version></artifactItem>
                <artifactItem><groupId>javax.mail</groupId><artifactId>mail</artifactId><version>1.4.7</version></artifactItem>
                <artifactItem><groupId>net.bytebuddy</groupId><artifactId>byte-buddy</artifactId><version>1.14.19</version></artifactItem>

                <artifactItem><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-reflect</artifactId><version>2.4.20</version></artifactItem>
                <artifactItem><groupId>io.netty</groupId><artifactId>netty-common</artifactId><version>4.1.138.Final</version></artifactItem>
                <artifactItem><groupId>io.netty</groupId><artifactId>netty-buffer</artifactId><version>4.1.138.Final</version></artifactItem>
                <artifactItem><groupId>io.netty</groupId><artifactId>netty-resolver</artifactId><version>4.1.138.Final</version></artifactItem>
                <artifactItem><groupId>io.netty</groupId><artifactId>netty-transport</artifactId><version>4.1.138.Final</version></artifactItem>
                <artifactItem><groupId>io.netty</groupId><artifactId>netty-transport-native-unix-common</artifactId><version>4.1.138.Final</version></artifactItem>
                <artifactItem><groupId>io.netty</groupId><artifactId>netty-codec</artifactId><version>4.1.138.Final</version></artifactItem>
                <artifactItem><groupId>io.netty</groupId><artifactId>netty-codec-http</artifactId><version>4.1.138.Final</version></artifactItem>
                <artifactItem><groupId>io.netty</groupId><artifactId>netty-handler</artifactId><version>4.1.138.Final</version></artifactItem>
                <artifactItem><groupId>org.apache.httpcomponents</groupId><artifactId>httpclient</artifactId><version>4.5.14</version></artifactItem>
                <artifactItem><groupId>org.apache.httpcomponents</groupId><artifactId>httpcore</artifactId><version>4.4.16</version></artifactItem>

                <artifactItem><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId><version>2.4.20</version></artifactItem>
                <artifactItem><groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-coroutines-core-jvm</artifactId><version>1.11.0</version></artifactItem>
                <artifactItem><groupId>org.scala-lang</groupId><artifactId>scala-library</artifactId><version>2.13.18</version></artifactItem>
                <artifactItem><groupId>org.scala-lang</groupId><artifactId>scala3-library_3</artifactId><version>3.7.4</version></artifactItem>
                <artifactItem><groupId>org.apache.groovy</groupId><artifactId>groovy</artifactId><version>4.0.33</version></artifactItem>
                <artifactItem><groupId>org.clojure</groupId><artifactId>clojure</artifactId><version>1.12.6</version></artifactItem>
                <artifactItem><groupId>org.clojure</groupId><artifactId>spec.alpha</artifactId><version>0.6.249</version></artifactItem>
                <artifactItem><groupId>org.clojure</groupId><artifactId>core.specs.alpha</artifactId><version>0.4.74</version></artifactItem>

                <artifactItem><groupId>com.h2database</groupId><artifactId>h2</artifactId><version>2.3.232</version></artifactItem>
                <artifactItem><groupId>org.eclipse.jdt</groupId><artifactId>ecj</artifactId><version>3.46.0</version></artifactItem>
                <artifactItem><groupId>org.antlr</groupId><artifactId>antlr4-runtime</artifactId><version>4.13.2</version></artifactItem>
                <artifactItem><groupId>org.apache.lucene</groupId><artifactId>lucene-core</artifactId><version>10.5.1</version></artifactItem>

                <artifactItem><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-core</artifactId><version>2.22.3</version></artifactItem>
                <artifactItem><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.22.3</version></artifactItem>
                <artifactItem><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-annotations</artifactId><version>2.22</version></artifactItem>
                <artifactItem><groupId>com.google.guava</groupId><artifactId>guava</artifactId><version>33.6.0-jre</version></artifactItem>
                <artifactItem><groupId>com.google.guava</groupId><artifactId>failureaccess</artifactId><version>1.0.3</version></artifactItem>
                <artifactItem><groupId>org.springframework</groupId><artifactId>spring-core</artifactId><version>7.0.9</version></artifactItem>
                <artifactItem><groupId>org.springframework</groupId><artifactId>spring-beans</artifactId><version>7.0.9</version></artifactItem>
                <artifactItem><groupId>org.springframework</groupId><artifactId>spring-aop</artifactId><version>7.0.9</version></artifactItem>
                <artifactItem><groupId>org.springframework</groupId><artifactId>spring-expression</artifactId><version>7.0.9</version></artifactItem>
                <artifactItem><groupId>org.springframework</groupId><artifactId>spring-context</artifactId><version>7.0.9</version></artifactItem>
                <artifactItem><groupId>commons-logging</groupId><artifactId>commons-logging</artifactId><version>1.4.0</version></artifactItem>
                <artifactItem><groupId>io.micrometer</groupId><artifactId>micrometer-observation</artifactId><version>1.17.1</version></artifactItem>
                <artifactItem><groupId>io.micrometer</groupId><artifactId>micrometer-commons</artifactId><version>1.17.1</version></artifactItem>
                <artifactItem><groupId>org.hibernate.orm</groupId><artifactId>hibernate-core</artifactId><version>7.4.5.Final</version></artifactItem>
                <artifactItem><groupId>org.hibernate.models</groupId><artifactId>hibernate-models</artifactId><version>1.1.1</version></artifactItem>
                <artifactItem><groupId>jakarta.persistence</groupId><artifactId>jakarta.persistence-api</artifactId><version>3.2.0</version></artifactItem>
                <artifactItem><groupId>jakarta.transaction</groupId><artifactId>jakarta.transaction-api</artifactId><version>2.0.1</version></artifactItem>
                <artifactItem><groupId>jakarta.xml.bind</groupId><artifactId>jakarta.xml.bind-api</artifactId><version>4.0.4</version></artifactItem>
                <artifactItem><groupId>jakarta.inject</groupId><artifactId>jakarta.inject-api</artifactId><version>2.0.1</version></artifactItem>
                <artifactItem><groupId>org.jboss.logging</groupId><artifactId>jboss-logging</artifactId><version>3.6.1.Final</version></artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestFile>MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>compile-fixtures8</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${fixtures8.classes}"/>
                <javac srcdir="${project.basedir}/src/test/fixtures8" destdir="${fixtures8.classes}" release="8" encoding="UTF-8" includeantruntime="false" debug="true" debuglevel="lines,source" failonerror="true">
                  <compilerarg value="-Xlint:all,-options"/>
                  <compilerarg value="-Werror"/>
                </javac>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>compile-corpus-fixtures</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <skip>${skipTests}</skip>
              <target>
                <mkdir dir="${corpus.fixtures.classes}"/>
                <javac srcdir="${project.basedir}/src/test/corpus-fixtures" destdir="${corpus.fixtures.classes}" release="25" encoding="UTF-8" includeantruntime="false" debug="true" failonerror="true">
                  <classpath>
                    <fileset dir="${corpus.dir}" includes="*.jar"/>
                  </classpath>
                  <compilerarg value="-Xlint:all,-options"/>
                  <compilerarg value="-Werror"/>
                </javac>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>package-gate-jar</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <jar destfile="${e2e.gate.jar}" basedir="${project.build.testOutputDirectory}" includes="io/github/yagipass/verbatime/fixtures/**">
                  <manifest>
                    <attribute name="Main-Class" value="io.github.yagipass.verbatime.fixtures.GateMain"/>
                  </manifest>
                </jar>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <skip>${skipTests}</skip>
          <executable>${java.bin}</executable>
        </configuration>
        <executions>
          <execution>
            <id>test</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-Xverify:all</argument>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.fixtures8=${fixtures8.classes}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.tmp=${project.build.directory}/test-tmp</argument>
                <argument>io.github.yagipass.verbatime.agent.test.TestMain</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>method-id-limit</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-Xverify:all</argument>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.tmp=${project.build.directory}/test-tmp</argument>
                <argument>io.github.yagipass.verbatime.agent.MethodIdLimitTest</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>corpus-verify</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.corpus=${corpus.dirs}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.corpus.threads=${corpus.threads}</argument>
                <argument>io.github.yagipass.verbatime.agent.CorpusVerifyTest</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>corpus-selftest</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.corpus=${corpus.dir}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.corpus.threads=${corpus.threads}</argument>
                <argument>io.github.yagipass.verbatime.agent.CorpusSelfTest</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>corpus-roundtrip</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.corpus=${corpus.dir}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.corpus.fixtures=${corpus.fixtures.classes}</argument>
                <argument>io.github.yagipass.verbatime.agent.CorpusRoundTripTest</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>corpus-callers</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.corpus=${corpus.dir}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.corpus.fixtures=${corpus.fixtures.classes}</argument>
                <argument>io.github.yagipass.verbatime.agent.CorpusCallerTest</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-agent</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-XX:+UseSerialGC</argument>
                <argument>-javaagent:${agent.jar}=${e2e.include},out=${project.build.directory}/test-tmp/e2e.vbtm</argument>
                <argument>-cp</argument>
                <argument>${project.build.testOutputDirectory}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EMain</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-verify</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EVerify</argument>
                <argument>${project.build.directory}/test-tmp/e2e.vbtm</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-agent</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-javaagent:${agent.jar}=${e2e.include},waitstart=10s,out=${project.build.directory}/test-tmp/e2e-gate.vbtm</argument>
                <argument>-cp</argument>
                <argument>${project.build.testOutputDirectory}</argument>
                <argument>io.github.yagipass.verbatime.fixtures.GateMain</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-verify</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EGateVerify</argument>
                <argument>${project.build.directory}/test-tmp/e2e-gate.vbtm</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-instance-agent</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-javaagent:${agent.jar}=${e2e.include},waitstart=10s,out=${project.build.directory}/test-tmp/e2e-gate-instance.vbtm</argument>
                <argument>-cp</argument>
                <argument>${project.build.testOutputDirectory}</argument>
                <argument>io.github.yagipass.verbatime.fixtures.InstanceGateMain</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-instance-verify</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EGateVerify</argument>
                <argument>${project.build.directory}/test-tmp/e2e-gate-instance.vbtm</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-jar-agent</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-javaagent:${agent.jar}=${e2e.include},waitstart=10s,out=${project.build.directory}/test-tmp/e2e-gate-jar.vbtm</argument>
                <argument>-jar</argument>
                <argument>${e2e.gate.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-jar-verify</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EGateVerify</argument>
                <argument>${project.build.directory}/test-tmp/e2e-gate-jar.vbtm</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-module-agent</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-javaagent:${agent.jar}=${e2e.include},waitstart=10s,out=${project.build.directory}/test-tmp/e2e-gate-module.vbtm</argument>
                <argument>--module-path=${e2e.gate.jar}</argument>
                <argument>-m</argument>
                <argument>gate.main</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-module-verify</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EGateVerify</argument>
                <argument>${project.build.directory}/test-tmp/e2e-gate-module.vbtm</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-timeout</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-javaagent:${agent.jar}=${e2e.include},waitstart=1s</argument>
                <argument>-cp</argument>
                <argument>${project.build.testOutputDirectory}</argument>
                <argument>io.github.yagipass.verbatime.fixtures.DemoMain</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-startup-agent</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-javaagent:${agent.jar}=${e2e.include},record=startup,roots=io.github.yagipass.verbatime.fixtures.Fixture::root+io.github.yagipass.verbatime.fixtures.Fixture::rootThrows,out=${project.build.directory}/test-tmp/e2e-startup.vbtm</argument>
                <argument>-cp</argument>
                <argument>${project.build.testOutputDirectory}</argument>
                <argument>io.github.yagipass.verbatime.fixtures.StartupMain</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-startup-verify</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EStartupVerify</argument>
                <argument>${project.build.directory}/test-tmp/e2e-startup.vbtm</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <includes combine.children="append">
              <include>src/test/fixtures8/**/*.java</include>
              <include>src/test/corpus-fixtures/**/*.java</include>
            </includes>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>corpus-full</id>
      <properties>
        <corpus.dirs>${corpus.dir}${path.separator}${corpus.full.dir}</corpus.dirs>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
