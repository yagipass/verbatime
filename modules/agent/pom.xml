<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.yagipass</groupId>
    <artifactId>verbatime</artifactId>
    <version>0.7.1</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>verbatime-agent</artifactId>
  <packaging>jar</packaging>

  <name>verbatime-agent</name>
  <description>Java agent that records a call tree per root-method execution</description>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <skipTests>false</skipTests>

    <java.bin>${java.home}/bin/java</java.bin>
    <fixtures8.classes>${project.build.directory}/fixtures8-classes</fixtures8.classes>
    <agent.jar>${project.build.directory}/verbatime-agent.jar</agent.jar>
    <e2e.include>include=io.github.yagipass.verbatime.fixtures</e2e.include>
    <e2e.gate.jar>${project.build.directory}/test-tmp/dir with space/gate-main.jar</e2e.gate.jar>
    <test.classpath>${project.build.testOutputDirectory}${path.separator}${project.build.outputDirectory}${path.separator}${io.github.yagipass:verbatime-format:jar}</test.classpath>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.yagipass</groupId>
      <artifactId>verbatime-format</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>format-jar-property</id>
            <?m2e ignore?>
            <phase>initialize</phase>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestFile>MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>compile-fixtures8</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${fixtures8.classes}"/>
                <javac srcdir="${project.basedir}/src/test/fixtures8" destdir="${fixtures8.classes}" release="8" encoding="UTF-8" includeantruntime="false" debug="true" debuglevel="lines,source" failonerror="true">
                  <compilerarg value="-Xlint:all,-options"/>
                  <compilerarg value="-Werror"/>
                </javac>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>package-gate-jar</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <jar destfile="${e2e.gate.jar}" basedir="${project.build.testOutputDirectory}" includes="io/github/yagipass/verbatime/fixtures/**">
                  <manifest>
                    <attribute name="Main-Class" value="io.github.yagipass.verbatime.fixtures.GateMain"/>
                  </manifest>
                </jar>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <skip>${skipTests}</skip>
          <executable>${java.bin}</executable>
        </configuration>
        <executions>
          <execution>
            <id>test</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-Xverify:all</argument>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.fixtures8=${fixtures8.classes}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.tmp=${project.build.directory}/test-tmp</argument>
                <argument>io.github.yagipass.verbatime.agent.test.TestMain</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>method-id-limit</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-Xverify:all</argument>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>-Dio.github.yagipass.verbatime.agent.test.tmp=${project.build.directory}/test-tmp</argument>
                <argument>io.github.yagipass.verbatime.agent.MethodIdLimitTest</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-agent</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-XX:+UseSerialGC</argument>
                <argument>-javaagent:${agent.jar}=${e2e.include},out=${project.build.directory}/test-tmp/e2e.vbtm</argument>
                <argument>-cp</argument>
                <argument>${project.build.testOutputDirectory}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EMain</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-verify</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EVerify</argument>
                <argument>${project.build.directory}/test-tmp/e2e.vbtm</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-agent</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-javaagent:${agent.jar}=${e2e.include},waitstart=10s,out=${project.build.directory}/test-tmp/e2e-gate.vbtm</argument>
                <argument>-cp</argument>
                <argument>${project.build.testOutputDirectory}</argument>
                <argument>io.github.yagipass.verbatime.fixtures.GateMain</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-verify</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EGateVerify</argument>
                <argument>${project.build.directory}/test-tmp/e2e-gate.vbtm</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-instance-agent</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-javaagent:${agent.jar}=${e2e.include},waitstart=10s,out=${project.build.directory}/test-tmp/e2e-gate-instance.vbtm</argument>
                <argument>-cp</argument>
                <argument>${project.build.testOutputDirectory}</argument>
                <argument>io.github.yagipass.verbatime.fixtures.InstanceGateMain</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-instance-verify</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EGateVerify</argument>
                <argument>${project.build.directory}/test-tmp/e2e-gate-instance.vbtm</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-jar-agent</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-javaagent:${agent.jar}=${e2e.include},waitstart=10s,out=${project.build.directory}/test-tmp/e2e-gate-jar.vbtm</argument>
                <argument>-jar</argument>
                <argument>${e2e.gate.jar}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-jar-verify</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EGateVerify</argument>
                <argument>${project.build.directory}/test-tmp/e2e-gate-jar.vbtm</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-module-agent</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-javaagent:${agent.jar}=${e2e.include},waitstart=10s,out=${project.build.directory}/test-tmp/e2e-gate-module.vbtm</argument>
                <argument>--module-path=${e2e.gate.jar}</argument>
                <argument>-m</argument>
                <argument>gate.main</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-module-verify</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EGateVerify</argument>
                <argument>${project.build.directory}/test-tmp/e2e-gate-module.vbtm</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-gate-timeout</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-javaagent:${agent.jar}=${e2e.include},waitstart=1s</argument>
                <argument>-cp</argument>
                <argument>${project.build.testOutputDirectory}</argument>
                <argument>io.github.yagipass.verbatime.fixtures.DemoMain</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-startup-agent</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-javaagent:${agent.jar}=${e2e.include},record=startup,roots=io.github.yagipass.verbatime.fixtures.Fixture::root+io.github.yagipass.verbatime.fixtures.Fixture::rootThrows,out=${project.build.directory}/test-tmp/e2e-startup.vbtm</argument>
                <argument>-cp</argument>
                <argument>${project.build.testOutputDirectory}</argument>
                <argument>io.github.yagipass.verbatime.fixtures.StartupMain</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-startup-verify</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-cp</argument>
                <argument>${test.classpath}</argument>
                <argument>io.github.yagipass.verbatime.agent.test.E2EStartupVerify</argument>
                <argument>${project.build.directory}/test-tmp/e2e-startup.vbtm</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <includes combine.children="append">
              <include>src/test/fixtures8/**/*.java</include>
            </includes>
          </java>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
